<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema principal do aplicativo -->
    <style name="Base.Theme.LembraAi" parent="Theme.Material3.DayNight">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- Tema padrão: mantém a ActionBar -->
    <style name="Theme.LembraAi" parent="Base.Theme.LembraAi" />

    <!-- Tema sem ActionBar para Login e Cadastro -->
    <style name="Theme.LembraAi.SemActionBar" parent="Theme.LembraAi">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Splash oficial, sem atraso artificial -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.LembraAi</item>
    </style>

</resources>